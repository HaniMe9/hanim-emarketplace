{
  "name": "hanimarket",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HaniMarket — B2C + B2B marketplace for Ethiopia (modular monolith, full-stack reference implementation)",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b tsconfig.build.json && vite build",
    "start": "node --experimental-strip-types server/index.ts",
    "typecheck": "tsc -b tsconfig.build.json",
    "lint": "tsc -b tsconfig.build.json",
    "test": "npm run typecheck && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --headed"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@vercel/speed-insights": "^2.1.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
